project NheO is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("nheo_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2022",
         "-gnatwa",
         "-gnata",
         "-gnatQ"
      );
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end NheO;
