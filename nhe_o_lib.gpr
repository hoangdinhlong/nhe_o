with "config/nhe_o_config.gpr";

library project Nhe_O_Lib is
   for Source_Dirs use ("src");
   for Excluded_Source_Files use ("nhe_o_main.adb");
   for Object_Dir use "obj/lib";
   for Create_Missing_Dirs use "True";
   for Library_Name use "nhe_o";
   for Library_Dir use "lib";
   for Library_Kind use "relocatable";
   for Library_Interface use (
      "Nhe_O",
      "Nhe_O.Types",
      "Nhe_O.IO",
      "Nhe_O.Vector",
      "Nhe_O.JSON",
      "Nhe_O.SQL",
      "Nhe_O.Transaction",
      "Nhe_O.BTree",
      "Nhe_O.HNSW",
      "Nhe_O.KV",
      "Nhe_O.PubSub",
      "Nhe_O.RAG",
      "Nhe_O.C_API"
   );
   for Library_Auto_Init use "true";

   --  No -gnata: every assertion (Pre/Post/Assert/Loop_Invariant) is proved statically
   --  by gnatprove, and executing them would only add stack (whole-engine 'Old copies)
   --  and an exception path that cannot cross the C ABI. Run-time checks stay enabled.
   --  The verification executable (nhe_o.gpr) keeps -gnata.
   --  -fstack-check probes large frames page by page, so overflowing the calling
   --  thread's stack always hits its guard page instead of skipping past it into
   --  adjacent memory: the process then terminates (Storage_Error in the thread that
   --  loaded the library, SIGSEGV in other host threads).
   package Compiler is
      for Default_Switches ("Ada") use (
         "-O2",
         "-g",
         "-gnat2022",
         "-gnatwa",
         "-gnatQ",
         "-fPIC",
         "-fstack-check"
      );
   end Compiler;
end Nhe_O_Lib;
