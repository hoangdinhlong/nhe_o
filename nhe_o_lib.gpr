library project Nhe_O_Lib is
   for Source_Dirs use ("src");
   for Excluded_Source_Files use ("nhe_o_main.adb");
   for Object_Dir use "obj/lib";
   for Library_Name use "nhe_o";
   for Library_Dir use "lib";
   for Library_Kind use "relocatable";
   for Library_Interface use (
      "Nhe_O",
      "Nhe_O.Types",
      "Nhe_O.IO",
      "Nhe_O.Vector",
      "Nhe_O.JSON",
      "Nhe_O.SQL",
      "Nhe_O.Transaction",
      "Nhe_O.BTree",
      "Nhe_O.HNSW",
      "Nhe_O.KV",
      "Nhe_O.PubSub",
      "Nhe_O.RAG",
      "Nhe_O.C_API"
   );
   for Library_Auto_Init use "true";

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2022",
         "-gnatwa",
         "-gnata",
         "-gnatQ",
         "-fPIC"
      );
   end Compiler;
end Nhe_O_Lib;
